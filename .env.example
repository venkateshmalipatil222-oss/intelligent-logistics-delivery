# ==============================================================================
# INTELLIGENT LOGISTICS & DELIVERY OPTIMIZATION PLATFORM (ILDO)
# Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# ==============================================================================

PROJECT_NAME="Intelligent Logistics & Delivery Optimization Platform (ILDO)"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Application Security
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL Database Configuration
MYSQL_USER="root"
MYSQL_PASSWORD="your-mysql-password"
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_DB="ildo_db"

# SQLAlchemy Database URL (Constructed or overridden)
DATABASE_URL="mysql+pymysql://root:your-mysql-password@localhost:3306/ildo_db"

# Fallback Flag (Optional: Set true to automatically fallback to SQLite if MySQL is unreachable during development)
USE_SQLITE_FALLBACK=false
SQLITE_DB_PATH="ildo_dev.db"

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL_SECONDS=30

# Algorithmic & Engine Defaults
MAX_DELIVERY_RADIUS_KM=50.0
DEFAULT_AVERAGE_SPEED_KMH=35.0
DEFAULT_STOP_SERVICE_MINUTES=10
DEFAULT_ETA_UNCERTAINTY_BUFFER_MINUTES=5
DELAY_RISK_THRESHOLD_MINUTES=15

# Cost Parameters (Estimations)
FUEL_PRICE_PER_LITER=1.50
DEFAULT_VEHICLE_EFFICIENCY_KMPL=12.0
DRIVER_HOURLY_RATE=18.00
VEHICLE_MAINTENANCE_PER_KM=0.15
BASE_DISPATCH_FEE=5.00
